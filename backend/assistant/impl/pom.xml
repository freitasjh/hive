<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.systec.hive</groupId>
        <artifactId>hive-assistant</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hive-assistant-impl</artifactId>
    <name>Hive Assistant Impl</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-commons-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-commons-api</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-assistant-api</artifactId>
        </dependency>
        <!-- ADR-017: ChatServiceImpl/TurnOutcomeMapper e seus testes usam ChatMessage,
             ChatMessageService e ProviderMessages — todos em history/api. -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-history-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ADR-016/017: adapter JPA de histórico saiu daqui para history/impl;
             esta aresta serve apenas ao wiring das classes que usam repository/entity. -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-history-impl</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-identity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-provider-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- TenantLlmConfigService: o provider/modelo padrão é do tenant. Só a api —
             a implementação fica em tenant/impl e o chat nunca a vê. -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-tenant-api</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-provider-langchain4j</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <!-- ADR-020: AiServices, @MemoryId/@SystemMessage, MessageWindowChatMemory e Result<T>
             vivem no agregado `langchain4j`, não no core (verificado no jar 1.19.0, 2026-11-21).
             O bootstrap já carrega o agregado em runtime; escopo `provided` vem do dependencyManagement. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
