<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.systec.hive</groupId>
        <artifactId>hive</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hive-bootstrap</artifactId>
    <name>Hive Bootstrap</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-scalar</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Modulos do projeto -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-commons-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-commons-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-commons-api-tools</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-tenant-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-tenant-dbupdate</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-tenant-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-tenant-web-internal-v1</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-identity-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-identity-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-identity-dbupdate</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-identity-web-internal-v1</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-security-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-security-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-security-web-internal-v1</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- ADR-021: ai/api + ai/impl no classpath de runtime: assistant e publicapi chamam a porta
             ChatTurnGateway e o proxy AiService/extensoes de memoria precisam do agregado. -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-ai-api</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-ai-impl</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-assistant-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-assistant-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- ADR-016/017: history/impl entra no classpath de runtime para o @Service
             implementador da porta ChatMessageService e seus @Repository/@Mapper serem descobertos. -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-history-impl</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-assistant-web-internal-v1</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- ADR-017: @RestController de GET /v1/chat/sessions/{id}/messages (history/web). -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-history-web-internal-v1</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-assistant-dbupdate</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Public API -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-publicapi-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-publicapi-impl</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-publicapi-dbupdate</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-publicapi-web-internal-v1</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Provedores de IA -->
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-provider-api</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>br.com.systec.hive</groupId>
            <artifactId>hive-provider-langchain4j</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <scope>compile</scope>
        </dependency>
        <!--
          The LangChain4j aggregator, needed by the provider module at runtime. Declared at compile
          scope here because the rest of dev.langchain4j is `provided` in the modules that use it,
          and a provided dependency does not reach the runtime classpath on its own.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>

</project>