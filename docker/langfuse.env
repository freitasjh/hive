# Template de secrets do Langfuse local — NAO contem segredos reais.
# Copie para docker/.env.langfuse (ignorado pelo git) e substitua TODOS os __...__ .
# Gere os valores com openssl (exemplos no final do docker/docker-compose-langfuse.yml).
# Regras de acoplamento:
#   DATABASE_URL e POSTGRES_PASSWORD usam o MESMO valor (__PG_PASSWORD__).
#   As 3 S3 secret keys e MINIO_ROOT_PASSWORD usam o MESMO valor (__MINIO_PASSWORD__).
# Nao use aspas nem espacos ao redor de =.

NEXTAUTH_URL=http://localhost:3000
LANGFUSE_IMAGE_TAG=4

DATABASE_URL=postgresql://postgres:__PG_PASSWORD__@postgres:5432/postgres
POSTGRES_PASSWORD=__PG_PASSWORD__
SALT=__SALT__
ENCRYPTION_KEY=__ENCRYPTION_KEY__
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__
CLICKHOUSE_PASSWORD=__CLICKHOUSE_PASSWORD__
REDIS_AUTH=__REDIS_AUTH__

MINIO_ROOT_PASSWORD=__MINIO_PASSWORD__
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=__MINIO_PASSWORD__
