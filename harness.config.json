{
  "version": 1,
  "project": "hive",
  "stack": {
    "backend": "Java 21 / Spring Boot 4.1.0 (Maven multi-module)",
    "frontend": "Vue 3.5 / TypeScript / Vite 8 (PrimeVue)"
  },
  "moduleMap": {
    "plugins": ".opencode/plugins",
    "rules": ".agents/rules",
    "schemas": ".agents/schemas",
    "backend": "backend",
    "frontend": "frontend"
  },
  "commands": {
    "suiteFull": "mvn clean install && cd frontend && npm run test && npm run build",
    "unit": "mvn test",
    "integration": "mvn verify -pl integration-test",
    "frontendTest": "cd frontend && npm run test",
    "frontendBuild": "cd frontend && npm run build",
    "backendRun": "mvn spring-boot:run -pl bootstrap",
    "frontendRun": "cd frontend && npm run dev"
  },
  "infra": {
    "composeFile": "docker/docker-compose-vetor.yml",
    "ports": {
      "backend": 8080,
      "frontend": 5173,
      "postgres": 5433,
      "redis": 6379
    }
  },
  "mcp": {
    "required": [
      "chrome-devtools"
    ]
  },
  "protectedPaths": [
    ".opencode/plugins/**",
    ".agents/rules/**",
    ".agents/schemas/**",
    ".agents/agents/**",
    "opencode.json",
    "harness.config.json"
  ],
  "gates": {
    "picco": "enforce",
    "evidence": "enforce",
    "hitlBatch": "enforce",
    "e2eGreenfield": "warn"
  },
  "riskPaths": [
    "**/security/**",
    "**/auth/**",
    "**/provider/**"
  ],
  "escalateOnRisk": {
    "e2eGreenfield": "enforce",
    "evidenceScenario": "required"
  },
  "contraproveTimeoutMs": 900000,
  "evidence": {
    "path": "harness/",
    "schema": ".agents/schemas/harness-report.schema.json"
  }
}