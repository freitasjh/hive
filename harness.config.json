{
  "version": 2,
  "project": "hive",
  "targets": {
    "frontend": "react",
    "backend": "java"
  },
  "moduleMap": {
    "plugins": ".opencode/plugins",
    "rules": ".agents/rules",
    "schemas": ".agents/schemas"
  },
  "commands": {
    "suiteFull": "npm test",
    "unit": "npm test"
  },
  "mcp": {
    "required": [
      "chrome-devtools"
    ]
  },
  "protectedPaths": [
    ".opencode/plugins/**",
    ".opencode/plugins/__tests__/**",
    ".agents/rules/**",
    ".agents/schemas/**",
    ".agents/agents/**",
    ".github/workflows/**",
    ".githooks/**",
    "opencode.json",
    "harness.config.json"
  ],
  "gates": {
    "picco": "enforce",
    "evidence": "enforce",
    "hitlBatch": "enforce",
    "e2eGreenfield": "warn"
  },
  "contraproveTimeoutMs": 900000,
  "evidence": {
    "path": "harness/"
  }
}
